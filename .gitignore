# ==========================================================================
# Dependencies (installed via composer / npm — reproducible from lock files)
# ==========================================================================
**/vendor/
**/node_modules/

# ==========================================================================
# Environment & secrets — NEVER commit these
# ==========================================================================
**/.env
**/.env.backup
**/.env.production
*.pem
*.key
auth.json

# ==========================================================================
# Laravel / Bagisto runtime & build artifacts (my-store install)
# ==========================================================================
my-store/storage/*.key
my-store/storage/app/**
my-store/storage/framework/cache/**
my-store/storage/framework/sessions/**
my-store/storage/framework/testing/**
my-store/storage/framework/views/**
my-store/storage/*.log
my-store/storage/logs/**
my-store/bootstrap/cache/*.php
my-store/public/storage
my-store/public/build
my-store/public/hot
my-store/public/cache

# Keep .gitignore placeholders inside storage dirs
!my-store/storage/**/.gitignore
!my-store/storage/logs/.gitignore

# Compiled front-end theme assets (regenerated by `npm run build`)
my-store/public/themes/*/*/build/

# Homestead / Vagrant
Homestead.json
Homestead.yaml
.vagrant

# ==========================================================================
# Local dev / QA scratch files (temporary artifacts, not source)
# ==========================================================================
cookies.txt
*.cookies
product_create_resp.json
products_index.html
*.tmp

# ==========================================================================
# Editor / IDE / OS files
# ==========================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
*.sublime-project
*.sublime-workspace

# Keep .vscode  and kiro settings out of version control (personal env)
.vscode/
.kiro/


# ==========================================================================
# Logs & debug
# ==========================================================================
*.log
npm-debug.log*
yarn-error.log

# ==========================================================================
# API keys
# ==========================================================================
rzp-key.csv

